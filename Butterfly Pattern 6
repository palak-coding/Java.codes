//BUTTERFLY PATTERN

class Main {
    public static void main(String[] args) {
    int n=4;
//First half
//1st part star print
    for(int i=1;i<=n;i++){
        for(int j=1;j<=i;j++){
        System.out.print("*");
        }
//Space in btw 1st and 2nd  half
     for(int j=1;j<=2*(n-i);j++){
     System.out.print(" ");
     }
//start print in 2nd part
      for(int j=1;j<=i;j++){
     System.out.print("*");
        }
        System.out.println();
    }
//Second half
//3rd part star print
        for(int i=n;i>=1;i--){
        for(int j=1;j<=i;j++){
        System.out.print("*");
        }
//Space btw 2nd half
     for(int j=1;j<=2*(n-i);j++){
     System.out.print(" ");
     }
//star print 4th part
      for(int j=1;j<=i;j++){
     System.out.print("*");
        }
        System.out.println();
    }
}
}
