/Inverted half pyramid 
public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    for(int i=1;i<=n;i++){
	        // inner loop for space print
	        for(int j=n-i;j>=0;j--){
	            System.out.print(" ");
	        }
	        //inner loop for stars print 
	        for(int j=1;j<=i;j++){
	            System.out.print("*");
	        }
	        System.out.println();	    }
	}
}
